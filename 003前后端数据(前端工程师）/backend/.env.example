# =============================================================================
# 随手记账 MVP - 后端环境变量(模板,拷贝为 .env 后修改)
# =============================================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=keep_accounts

# 服务端口
PORT=3000

# 会话过期时长(毫秒)
SESSION_TTL_DEFAULT=86400000
SESSION_TTL_REMEMBER=604800000

# CORS 允许的来源
CORS_ORIGIN=*
