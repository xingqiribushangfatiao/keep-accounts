# 随手记账 MVP - MySQL 客户端/服务端字符集配置
# ----------------------------------------------------------------------------
# 目的:避免 latin1 默认字符集导致的中文/emoji 双重编码(乱码)
# 挂载方式:-v ./my.cnf:/etc/mysql/conf.d/charset.cnf
# ----------------------------------------------------------------------------

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4

[mysqld]
character-set-server   = utf8mb4
collation-server       = utf8mb4_unicode_ci
init-connect           = 'SET NAMES utf8mb4'

[client-server]
!include /etc/mysql/conf.d/mysql-default-character-set.cnf
